{
  "expo": {
    "name": "EvolveFit",
    "slug": "evolvefit",
    "scheme": "evolvefit",
    "icon": "./assets/icon.png",
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "reactCompiler": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050816"
      }
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#050816",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ]
  }
}